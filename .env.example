# Direct PostgreSQL connection used only by Drizzle CLI and migration scripts.
DATABASE_URL="postgresql://aaeasy:aaeasy@localhost:5432/aaeasy?sslmode=disable"
DIRECT_DATABASE_URL="postgresql://aaeasy:aaeasy@localhost:5432/aaeasy?sslmode=disable"

# Overrides the local Hyperdrive connection without committing credentials.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://aaeasy:aaeasy@localhost:5432/aaeasy?sslmode=disable"

# Local OIDC secrets. Register the `aaeasy` client in auth-staging.pangda.app,
# then generate OIDC_SESSION_SECRET with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OIDC_CLIENT_SECRET="replace-with-staging-client-secret"
OIDC_SESSION_SECRET="replace-with-32-byte-base64url-secret"

# OpenAI-compatible AI endpoint. A provider API key, Gateway token, or both may be used.
AI_API_URL="https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-name>/<provider>/v1/chat/completions"
AI_MODEL="qwen-plus"
AI_PROVIDER="dashscope"
AI_GATEWAY_TOKEN=""
AI_API_KEY=""
DASHSCOPE_API_KEY=""
AI_ENABLE_IMAGE_CONTEXT="true"

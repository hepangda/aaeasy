{
  "name": "aaeasy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wrangler": "pnpm build:local && wrangler dev",
    "dev:pdf": "CLOUDFLARE_REMOTE_BROWSER=true vite",
    "build": "CLOUDFLARE_ENV=production CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
    "build:local": "vite build",
    "preview": "vite preview",
    "deploy": "tsx scripts/check-cloudflare-config.ts && pnpm build && wrangler deploy",
    "start": "vite preview",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "auth:setup": "tsx scripts/setup-local-auth.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "cf:typegen": "wrangler types --env production --env-file /dev/null && prettier --write worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aaeasy/contracts": "workspace:*",
    "@aaeasy/core": "workspace:*",
    "@aaeasy/db": "workspace:*",
    "@cloudflare/puppeteer": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.29",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.5",
    "wrangler": "^4.110.0"
  }
}
